rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // NOTE: There's no Firebase Auth here — login is just a name/password
    // check done in app.js against this collection. That means these rules
    // have to allow open read/write for sign up and login to work at all.
    // Anyone with your Firebase config (which is public in any web app)
    // can read every stored name/password and overwrite any user's record.
    // Fine for a low-stakes campus tool; don't put anything sensitive
    // (real passwords people reuse elsewhere, personal data) behind this.
    match /users/{userId} {
      allow read, write: if true;
    }

    // Votes collection — one document per user per meal session
    // (doc ID = "{slotId}__{userId}"). Same no-auth tradeoff as above:
    // anyone can read or overwrite anyone else's vote.
    match /votes/{voteId} {
      allow read, write: if true;
    }

    // Chef-editable menu/prices/deadlines/other-items, shared live with
    // every employee. Same no-auth tradeoff: anyone with the Firebase
    // config can edit this, not just the Chef — there's no server-side
    // role check yet, only a client-side one in chef.js.
    match /config/{docId} {
      allow read, write: if true;
    }

    // One doc per meal slot: Chef's eligibility override + freeze state.
    match /sessionStates/{slotId} {
      allow read, write: if true;
    }
  }
}
